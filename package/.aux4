{
  "scope": "agent",
  "name": "agent",
  "version": "3.0.0",
  "description": "AI agent with manager/worker architecture",
  "license": "Apache-2.0",
  "tags": [
    "ai",
    "agent",
    "manager",
    "worker"
  ],
  "dependencies": [
    "agent/manager",
    "agent/worker",
    "aux4/queue"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "agent",
          "execute": [
            "profile:agent"
          ],
          "help": {
            "text": "AI agent that understands, plans, and executes tasks"
          }
        }
      ]
    },
    {
      "name": "agent",
      "commands": [
        {
          "name": "start",
          "execute": [
            "nout:mkdir -p .agent/history",
            "nout:aux4 jobs run \"aux4 queue start --port ${queuePort}\" 2>/dev/null || true",
            "nout:sleep 1",
            "nout:aux4 jobs run \"aux4 cron start\" 2>/dev/null || true",
            "nout:sleep 1",
            "aux4 manager daemon start --every \"${every}\" --queuePort ${queuePort} --configFile ${configFile} --history .agent/history/default.json --memory .agent/memory",
            "log:Agent started"
          ],
          "help": {
            "text": "Start the agent",
            "variables": [
              {
                "name": "every",
                "text": "How often to check for work",
                "default": "5 min"
              },
              {
                "name": "queuePort",
                "text": "Queue server port",
                "default": "8420",
                "env": "QUEUE_PORT"
              },
              {
                "name": "configFile",
                "text": "Path to model configuration file",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "stop",
          "execute": [
            "nout:aux4 manager daemon stop --queuePort ${queuePort} 2>/dev/null || true",
            "nout:aux4 jobs killall 2>/dev/null || true",
            "nout:aux4 cron stop 2>/dev/null || true",
            "nout:aux4 queue stop --port ${queuePort} 2>/dev/null || true",
            "log:Agent stopped"
          ],
          "help": {
            "text": "Stop the agent",
            "variables": [
              {
                "name": "queuePort",
                "text": "Queue server port",
                "default": "8420",
                "env": "QUEUE_PORT"
              }
            ]
          }
        },
        {
          "name": "ask",
          "execute": [
            "nout:mkdir -p .agent/history",
            "nout:if(conversation!=) && echo .agent/history/${conversation}.json || echo .agent/history/default.json",
            "set:historyFile=${response}",
            "nout:if(instructions!=) && echo ${instructions} || (test -f AGENTS.md && echo AGENTS.md || echo '')",
            "set:resolvedInstructions=${response}",
            "nout:if(resolvedInstructions!=) && echo --workerInstructions ${resolvedInstructions} || echo ''",
            "set:workerInstructionsFlag=${response}",
            "nout:if(skills!=) && echo --workerSkills ${skills} || echo ''",
            "set:workerSkillsFlag=${response}",
            "aux4 manager ask --request \"${request}\" --configFile ${configFile} --workerConfigFile ${configFile} --history ${historyFile} --memory .agent/memory --queuePort ${queuePort} ${workerInstructionsFlag} ${workerSkillsFlag}"
          ],
          "help": {
            "text": "Send a request to the agent",
            "variables": [
              {
                "name": "request",
                "text": "The task or request to process",
                "arg": true
              },
              {
                "name": "conversation",
                "text": "Conversation name",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Path to model configuration file",
                "default": "config.yaml"
              },
              {
                "name": "instructions",
                "text": "Path to custom instructions file",
                "default": ""
              },
              {
                "name": "skills",
                "text": "Path to skills directory",
                "default": ""
              },
              {
                "name": "queuePort",
                "text": "Queue server port for channels",
                "default": "8420",
                "env": "QUEUE_PORT"
              }
            ]
          }
        },
        {
          "name": "new",
          "execute": [
            "nout:mkdir -p .agent/history",
            "nout:if(conversation!=) && echo .agent/history/${conversation}.json || echo .agent/history/default.json",
            "set:historyFile=${response}",
            "nout:aux4 ai agent remember ${historyFile} --configFile ${configFile} --config 2>/dev/null || echo ''",
            "nout:if(response==) && echo skip || aux4 kb add --folder .agent/memory --topic \"session-$(date +%Y-%m-%d)-$(date +%H%M%S)\" --content \"${response}\" --tags session 2>/dev/null",
            "nout:rm -f ${historyFile}",
            "log:New conversation started"
          ],
          "help": {
            "text": "Start a new conversation",
            "variables": [
              {
                "name": "conversation",
                "text": "Conversation name",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Path to model configuration file",
                "default": "config.yaml"
              }
            ]
          }
        },
        {
          "name": "resume",
          "execute": [
            "nout:mkdir -p .agent/history",
            "nout:if(conversation!=) && echo .agent/history/${conversation}.json || echo .agent/history/default.json",
            "set:historyFile=${response}",
            "aux4 manager resume --configFile ${configFile} --history ${historyFile} --memory .agent/memory --queuePort ${queuePort}"
          ],
          "help": {
            "text": "Resume a paused agent session",
            "variables": [
              {
                "name": "conversation",
                "text": "Conversation name",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Path to model configuration file",
                "default": ""
              },
              {
                "name": "queuePort",
                "text": "Queue server port for channels",
                "default": "8420",
                "env": "QUEUE_PORT"
              }
            ]
          }
        },
        {
          "name": "history",
          "execute": [
            "aux4 manager history"
          ],
          "help": {
            "text": "View past executions and their task lists"
          }
        }
      ]
    }
  ]
}
