{
  "scope": "agent",
  "name": "agent",
  "version": "4.2.27",
  "description": "AI agent powered by on-demand skills",
  "license": "Apache-2.0",
  "tags": [
    "ai",
    "agent"
  ],
  "dependencies": [
    "aux4/ai-agent",
    "aux4/todo",
    "aux4/jobs",
    "aux4/queue",
    "aux4/cron",
    "aux4/config",
    "aux4/kb",
    "aux4/search",
    "aux4/poller",
    "agent/skill-playbook@^0.2.3",
    "aux4/classify-jev@^0.2.0"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "agent",
          "execute": [
            "profile:agent"
          ],
          "help": {
            "text": "AI agent that understands, plans, and executes tasks"
          }
        }
      ]
    },
    {
      "name": "agent",
      "commands": [
        {
          "name": "start",
          "execute": [
            "nout:mkdir -p .agent/history",
            "nout:aux4 jobs run \"aux4 queue start --port ${queuePort}\" 2>/dev/null || true",
            "nout:sleep 1",
            "nout:aux4 jobs run \"aux4 cron start\" 2>/dev/null || true",
            "nout:sleep 1",
            "nout:aux4 cron add --name agent-heartbeat --every \"${heartbeat}\" --run \"aux4 agent ask 'Heartbeat: check your goal and task board; do the next thing that serves the goal, or rest.' --conversation heartbeat\" 2>/dev/null || true",
            "log:Agent started (heartbeat every ${heartbeat})"
          ],
          "help": {
            "text": "Start the agent",
            "variables": [
              {
                "name": "queuePort",
                "text": "Queue server port",
                "default": "8420",
                "env": "QUEUE_PORT"
              },
              {
                "name": "heartbeat",
                "text": "How often the agent wakes to check its goal and task board (e.g. 5m, 30s, 1 hour)",
                "default": "5m",
                "env": "AGENT_HEARTBEAT"
              }
            ]
          }
        },
        {
          "name": "stop",
          "execute": [
            "nout:aux4 cron remove --name agent-heartbeat 2>/dev/null || true",
            "nout:aux4 queue stop --port ${queuePort} 2>/dev/null || true",
            "log:Agent stopped"
          ],
          "help": {
            "text": "Stop the agent",
            "variables": [
              {
                "name": "queuePort",
                "text": "Queue server port",
                "default": "8420",
                "env": "QUEUE_PORT"
              }
            ]
          }
        },
        {
          "name": "ask",
          "execute": [
            "node ${packageDir}/lib/harness.mjs ask values(request, conversation, config, configFile, instructions, skills, image, tools, policy, permissions, output, presentation, conversationContext, activeArtifact, playbookFolder, playbookThreshold, classifierThreshold, classifyModel, classifyBaseUrl, classifyApiKey, brokerUrl, brokerToken, packageDir, builderAdapter, builderVm, builderScope, builderApiUrl, builderTimeoutMs, builderDecisions, builderBackends, builderAuto, builderSteps, builderModel)"
          ],
          "help": {
            "text": "Send a request to the agent",
            "variables": [
              {
                "name": "request",
                "text": "The task or request to process",
                "arg": true
              },
              {
                "name": "conversation",
                "text": "Conversation name",
                "default": ""
              },
              {
                "name": "config",
                "text": "Config section in --configFile to take the model from. Without it the agent falls back to the default model, which silently means the hosted one even when the section you named is local.",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Path to model configuration file",
                "default": "config.yaml"
              },
              {
                "name": "instructions",
                "text": "Path to custom instructions file",
                "default": ""
              },
              {
                "name": "skills",
                "text": "Path to skills directory",
                "default": ""
              },
              {
                "name": "image",
                "text": "Image file paths (comma-separated)",
                "default": ""
              },
              {
                "name": "tools",
                "text": "Comma-separated allow-list of tools to bind (e.g. executeAux4,aux4Skill). Binding every tool sends every tool description on each request; on a small model that context floor alone can stop it calling tools at all. Default: all tools.",
                "default": ""
              },
              {
                "name": "policy",
                "text": "Guardrails as JSON, e.g. '{\"budget\":{\"calls\":40}}'. Without a budget a run is unbounded: a single run on a metered endpoint reached 624 calls and 26M input tokens before a wall-clock timeout stopped it.",
                "default": "{\"budget\":{\"calls\":60}}"
              },
              {
                "name": "permissions",
                "text": "Command allow-list as JSON, e.g. '{\"allow\":[\"aux4 google gmail list\"]}'. Without it the agent may run any aux4 command; set it when a run must not reach a real account.",
                "default": ""
              },
              {
                "name": "output",
                "text": "Output shape: text preserves the traditional Markdown response; json emits a typed envelope with content, presentation, artifacts, and execution metadata.",
                "default": "text",
                "options": [
                  "text",
                  "json"
                ]
              },
              {
                "name": "presentation",
                "text": "Explicit presentation override: auto, markdown, markdown+inline-ui, markdown+app-proposal, or update-existing-ui.",
                "default": "auto",
                "options": [
                  "auto",
                  "markdown",
                  "markdown+inline-ui",
                  "markdown+app-proposal",
                  "update-existing-ui"
                ]
              },
              {
                "name": "conversationContext",
                "text": "Compact recent conversation context for presentation routing.",
                "default": ""
              },
              {
                "name": "activeArtifact",
                "text": "Active artifact as JSON; pure view requests reuse a complete typed artifact, while other follow-ups prefer update-existing-ui.",
                "default": ""
              },
              {
                "name": "playbookFolder",
                "text": "Folder containing learned playbooks.",
                "default": ".agent/playbooks"
              },
              {
                "name": "playbookThreshold",
                "text": "Minimum probability for deterministic playbook replay.",
                "default": "0.15"
              },
              {
                "name": "classifierThreshold",
                "text": "Minimum probability for a UI presentation; lower scores fall back to markdown.",
                "default": "0.55"
              },
              {
                "name": "classifyModel",
                "text": "JEV model used by playbook matching and presentation routing.",
                "default": "jev-1.13.0"
              },
              {
                "name": "classifyBaseUrl",
                "text": "Optional JEV API base URL override.",
                "default": ""
              },
              {
                "name": "classifyApiKey",
                "text": "Optional JEV API key.",
                "env": "TYPESAFE_API_KEY",
                "hide": true,
                "default": ""
              },
              {
                "name": "brokerUrl",
                "text": "Optional aux4 inference broker URL for presentation routing.",
                "env": "AUX4_INFERENCE_BROKER_URL",
                "default": ""
              },
              {
                "name": "brokerToken",
                "text": "Optional aux4 inference broker token.",
                "env": "AUX4_INFERENCE_BROKER_TOKEN",
                "hide": true,
                "default": ""
              },
              {
                "name": "builderAdapter",
                "text": "Builder adapter for JSON UI responses: local, cloud, or disabled.",
                "default": "local",
                "env": "AGENT_BUILDER_ADAPTER",
                "options": [
                  "local",
                  "cloud",
                  "disabled"
                ]
              },
              {
                "name": "builderVm",
                "text": "Cloud builder VM name.",
                "default": "builder",
                "env": "AGENT_BUILDER_VM"
              },
              {
                "name": "builderScope",
                "text": "Cloud scope containing the builder VM.",
                "default": "",
                "env": "AUX4_CLOUD_SCOPE"
              },
              {
                "name": "builderApiUrl",
                "text": "aux4 Cloud API URL used by the cloud builder adapter.",
                "default": "https://api.aux4.cloud",
                "env": "AUX4_CLOUD_API_URL"
              },
              {
                "name": "builderTimeoutMs",
                "text": "Builder timeout in milliseconds, clamped to 1000-300000.",
                "default": "120000",
                "env": "AGENT_BUILDER_TIMEOUT_MS"
              },
              {
                "name": "builderDecisions",
                "text": "Caller answers keyed by decision id as a JSON object.",
                "default": ""
              },
              {
                "name": "builderBackends",
                "text": "Optional backend package allow-list as a JSON array.",
                "default": ""
              },
              {
                "name": "builderAuto",
                "text": "Allow the builder to apply a clear candidate automatically; this never deploys an app.",
                "default": "true",
                "options": [
                  "true",
                  "false"
                ]
              },
              {
                "name": "builderSteps",
                "text": "Builder step cap, clamped to 1-50.",
                "default": "10"
              },
              {
                "name": "builderModel",
                "text": "Optional builder model override.",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "route",
          "execute": [
            "node ${packageDir}/lib/harness.mjs route values(request, presentation, conversationContext, activeArtifact, classifierThreshold, classifyModel, classifyBaseUrl, classifyApiKey, brokerUrl, brokerToken)"
          ],
          "help": {
            "text": "Choose a stable response presentation mode and print the decision as JSON",
            "variables": [
              {
                "name": "request",
                "text": "The user's current request.",
                "arg": true
              },
              {
                "name": "presentation",
                "text": "Explicit override, or auto to classify.",
                "default": "auto",
                "options": [
                  "auto",
                  "markdown",
                  "markdown+inline-ui",
                  "markdown+app-proposal",
                  "update-existing-ui"
                ]
              },
              {
                "name": "conversationContext",
                "text": "Compact recent conversation context.",
                "default": ""
              },
              {
                "name": "activeArtifact",
                "text": "Active artifact as JSON; complete typed artifacts can be reused by pure view requests.",
                "default": ""
              },
              {
                "name": "classifierThreshold",
                "text": "Minimum JEV probability for a UI mode.",
                "default": "0.55"
              },
              {
                "name": "classifyModel",
                "text": "JEV model identifier.",
                "default": "jev-1.13.0"
              },
              {
                "name": "classifyBaseUrl",
                "text": "Optional JEV API base URL override.",
                "default": ""
              },
              {
                "name": "classifyApiKey",
                "text": "Optional JEV API key.",
                "env": "TYPESAFE_API_KEY",
                "hide": true,
                "default": ""
              },
              {
                "name": "brokerUrl",
                "text": "Optional aux4 inference broker URL.",
                "env": "AUX4_INFERENCE_BROKER_URL",
                "default": ""
              },
              {
                "name": "brokerToken",
                "text": "Optional aux4 inference broker token.",
                "env": "AUX4_INFERENCE_BROKER_TOKEN",
                "hide": true,
                "default": ""
              }
            ]
          }
        },
        {
          "name": "new",
          "execute": [
            "nout:mkdir -p .agent/history",
            "nout:if(conversation!=) && echo .agent/history/${conversation}.json || echo .agent/history/default.json",
            "set:historyFile=${response}",
            "nout:aux4 ai agent remember ${historyFile} --configFile ${configFile} --config 2>/dev/null || echo ''",
            "nout:if(response==) && echo skip || aux4 kb add --folder .agent/memory --topic \"session-$(date +%Y-%m-%d)-$(date +%H%M%S)\" --content \"${response}\" --tags session 2>/dev/null",
            "nout:rm -f ${historyFile}",
            "log:New conversation started"
          ],
          "help": {
            "text": "Start a new conversation",
            "variables": [
              {
                "name": "conversation",
                "text": "Conversation name",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Path to model configuration file",
                "default": "config.yaml"
              }
            ]
          }
        },
        {
          "name": "resume",
          "execute": [
            "nout:mkdir -p .agent/history",
            "nout:if(conversation!=) && echo .agent/history/${conversation}.json || echo .agent/history/default.json",
            "set:historyFile=${response}",
            "nout:if(instructions!=) && echo ${instructions} || (test -f AGENTS.md && echo AGENTS.md || echo '')",
            "set:resolvedInstructions=${response}",
            "nout:if(resolvedInstructions!=) && echo --instructions ${resolvedInstructions} || echo ''",
            "set:instructionsFlag=${response}",
            "nout:if(skills!=) && echo ${skills} || (test -d skills && echo skills || echo '')",
            "set:resolvedSkills=${response}",
            "nout:if(resolvedSkills!=) && echo --skills ${resolvedSkills} || echo ''",
            "set:skillsFlag=${response}",
            "set:bio=!aux4 config get --configFile ${configFile} --name bio 2>/dev/null || echo {}",
            "aux4 ai agent ask --configFile ${configFile} --config --autoCompact true --baseInstructions ${packageDir}/instructions/agent.md param(bio) ${instructionsFlag} ${skillsFlag} --history ${historyFile} --question \"Resume: check current tasks with 'aux4 todo list' and continue from where you left off.\""
          ],
          "help": {
            "text": "Resume a paused agent session",
            "variables": [
              {
                "name": "conversation",
                "text": "Conversation name",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Path to model configuration file",
                "default": ""
              },
              {
                "name": "instructions",
                "text": "Path to custom instructions file",
                "default": ""
              },
              {
                "name": "skills",
                "text": "Path to skills directory",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "history",
          "execute": [
            "aux4 todo list"
          ],
          "help": {
            "text": "View past executions and their task lists"
          }
        }
      ]
    }
  ]
}
