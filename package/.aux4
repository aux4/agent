{
  "scope": "agent",
  "name": "agent",
  "version": "4.0.1",
  "description": "AI agent powered by on-demand skills",
  "license": "Apache-2.0",
  "tags": [
    "ai",
    "agent"
  ],
  "dependencies": [
    "aux4/ai-agent",
    "aux4/todo",
    "aux4/jobs",
    "aux4/queue",
    "aux4/cron",
    "aux4/config",
    "aux4/kb",
    "aux4/search",
    "aux4/poller"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "agent",
          "execute": [
            "profile:agent"
          ],
          "help": {
            "text": "AI agent that understands, plans, and executes tasks"
          }
        }
      ]
    },
    {
      "name": "agent",
      "commands": [
        {
          "name": "start",
          "execute": [
            "nout:mkdir -p .agent/history",
            "nout:aux4 jobs run \"aux4 queue start --port ${queuePort}\" 2>/dev/null || true",
            "nout:sleep 1",
            "nout:aux4 jobs run \"aux4 cron start\" 2>/dev/null || true",
            "nout:sleep 1",
            "nout:aux4 cron add --name agent-heartbeat --every \"${heartbeat}\" --run \"aux4 agent ask 'Heartbeat: check your goal and task board; do the next thing that serves the goal, or rest.' --conversation heartbeat\" 2>/dev/null || true",
            "log:Agent started (heartbeat every ${heartbeat})"
          ],
          "help": {
            "text": "Start the agent",
            "variables": [
              {
                "name": "queuePort",
                "text": "Queue server port",
                "default": "8420",
                "env": "QUEUE_PORT"
              },
              {
                "name": "heartbeat",
                "text": "How often the agent wakes to check its goal and task board (e.g. 5m, 30s, 1 hour)",
                "default": "5m",
                "env": "AGENT_HEARTBEAT"
              }
            ]
          }
        },
        {
          "name": "stop",
          "execute": [
            "nout:aux4 cron remove --name agent-heartbeat 2>/dev/null || true",
            "nout:aux4 queue stop --port ${queuePort} 2>/dev/null || true",
            "log:Agent stopped"
          ],
          "help": {
            "text": "Stop the agent",
            "variables": [
              {
                "name": "queuePort",
                "text": "Queue server port",
                "default": "8420",
                "env": "QUEUE_PORT"
              }
            ]
          }
        },
        {
          "name": "ask",
          "execute": [
            "nout:mkdir -p .agent/history",
            "nout:if(conversation!=) && echo .agent/history/${conversation}.json || echo .agent/history/default.json",
            "set:historyFile=${response}",
            "nout:if(instructions!=) && echo ${instructions} || (test -f AGENTS.md && echo AGENTS.md || echo '')",
            "set:resolvedInstructions=${response}",
            "nout:if(resolvedInstructions!=) && echo --instructions ${resolvedInstructions} || echo ''",
            "set:instructionsFlag=${response}",
            "nout:if(skills!=) && echo ${skills} || (test -d skills && echo skills || echo '')",
            "set:resolvedSkills=${response}",
            "nout:if(resolvedSkills!=) && echo --skills ${resolvedSkills} || echo ''",
            "set:skillsFlag=${response}",
            "nout:if(image!=) && echo --image ${image} || echo ''",
            "set:imageFlag=${response}",
            "set:bio=!aux4 config get --configFile ${configFile} --name bio 2>/dev/null || echo {}",
            "aux4 ai agent ask --configFile ${configFile} --config --autoCompact true --baseInstructions ${packageDir}/instructions/agent.md param(bio) ${instructionsFlag} ${skillsFlag} ${imageFlag} --history ${historyFile} --question \"${request}\""
          ],
          "help": {
            "text": "Send a request to the agent",
            "variables": [
              {
                "name": "request",
                "text": "The task or request to process",
                "arg": true
              },
              {
                "name": "conversation",
                "text": "Conversation name",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Path to model configuration file",
                "default": "config.yaml"
              },
              {
                "name": "instructions",
                "text": "Path to custom instructions file",
                "default": ""
              },
              {
                "name": "skills",
                "text": "Path to skills directory",
                "default": ""
              },
              {
                "name": "image",
                "text": "Image file paths (comma-separated)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "new",
          "execute": [
            "nout:mkdir -p .agent/history",
            "nout:if(conversation!=) && echo .agent/history/${conversation}.json || echo .agent/history/default.json",
            "set:historyFile=${response}",
            "nout:aux4 ai agent remember ${historyFile} --configFile ${configFile} --config 2>/dev/null || echo ''",
            "nout:if(response==) && echo skip || aux4 kb add --folder .agent/memory --topic \"session-$(date +%Y-%m-%d)-$(date +%H%M%S)\" --content \"${response}\" --tags session 2>/dev/null",
            "nout:rm -f ${historyFile}",
            "log:New conversation started"
          ],
          "help": {
            "text": "Start a new conversation",
            "variables": [
              {
                "name": "conversation",
                "text": "Conversation name",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Path to model configuration file",
                "default": "config.yaml"
              }
            ]
          }
        },
        {
          "name": "resume",
          "execute": [
            "nout:mkdir -p .agent/history",
            "nout:if(conversation!=) && echo .agent/history/${conversation}.json || echo .agent/history/default.json",
            "set:historyFile=${response}",
            "nout:if(instructions!=) && echo ${instructions} || (test -f AGENTS.md && echo AGENTS.md || echo '')",
            "set:resolvedInstructions=${response}",
            "nout:if(resolvedInstructions!=) && echo --instructions ${resolvedInstructions} || echo ''",
            "set:instructionsFlag=${response}",
            "nout:if(skills!=) && echo ${skills} || (test -d skills && echo skills || echo '')",
            "set:resolvedSkills=${response}",
            "nout:if(resolvedSkills!=) && echo --skills ${resolvedSkills} || echo ''",
            "set:skillsFlag=${response}",
            "set:bio=!aux4 config get --configFile ${configFile} --name bio 2>/dev/null || echo {}",
            "aux4 ai agent ask --configFile ${configFile} --config --autoCompact true --baseInstructions ${packageDir}/instructions/agent.md param(bio) ${instructionsFlag} ${skillsFlag} --history ${historyFile} --question \"Resume: check current tasks with 'aux4 todo list' and continue from where you left off.\""
          ],
          "help": {
            "text": "Resume a paused agent session",
            "variables": [
              {
                "name": "conversation",
                "text": "Conversation name",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Path to model configuration file",
                "default": ""
              },
              {
                "name": "instructions",
                "text": "Path to custom instructions file",
                "default": ""
              },
              {
                "name": "skills",
                "text": "Path to skills directory",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "history",
          "execute": [
            "aux4 todo list"
          ],
          "help": {
            "text": "View past executions and their task lists"
          }
        }
      ]
    }
  ]
}
